sap.ui.define(["sap/ui/core/mvc/ControllerExtension"], function (ControllerExtension) {                                                                                                                                                                        
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var DEFAULT_DAYS = 30;   // 기본 조회 기간(일)                                                                                                                                                                                                                    
    var _oExt = null;        // 확장 인스턴스                                                                                                                                                                                                                        
    var _bDone = false;      // 기본값은 한 번만 설정                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
    var pad = function (n) { return String(n).padStart(2, "0"); };                                                                                                                                                                                             
    var toIso = function (d) {                                                                                                                                                                                                                                 
        return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());                                                                                                                                                                         
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    function applyDefault(sFrom) {                                                                                                                                                                                                                             
        if (_bDone || !_oExt) { return; }                                                                                                                                                                                                                      
        console.log("[CM03] 기본값 설정 시도 (" + sFrom + ")");                                                                                                                                                                                                       
        try {                                                                                                                                                                                                                                                  
            var oTo = new Date();                                                                                                                                                                                                                              
            var oFrom = new Date();                                                                                                                                                                                                                            
            oFrom.setDate(oFrom.getDate() - DEFAULT_DAYS);                                                                                                                                                                                                     
            _oExt.base.getExtensionAPI().setFilterValues("crdat", "BT", [toIso(oFrom), toIso(oTo)]);                                                                                                                                                           
            _bDone = true;                                                                                                                                                                                                                                     
            console.log("[CM03] 발생일자 기본값 설정 완료", toIso(oFrom), toIso(oTo));                                                                                                                                                                                    
        } catch (e) {                                                                                                                                                                                                                                          
            console.error("[CM03] 발생일자 기본값 설정 실패", e);                                                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    return ControllerExtension.extend("cm03app.ext.controller.ListReportExt", {                                                                                                                                                                                
        override: {                                                                                                                                                                                                                                            
            onInit: function () {                                                                                                                                                                                                                              
                _oExt = this;                                                                                                                                                                                                                                  
                console.log("[CM03] ListReportExt onInit");                                                                                                                                                                                                    
            },                                                                                                                                                                                                                                                 
            onPageReady: function () {                                                                                                                                                                                                                         
                applyDefault("onPageReady");                                                                                                                                                                                                                   
            },                                                                                                                                                                                                                                                 
            routing: {                                                                                                                                                                                                                                         
                onAfterBinding: function () {                                                                                                                                                                                                                  
                    applyDefault("onAfterBinding");                                                                                                                                                                                                            
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            