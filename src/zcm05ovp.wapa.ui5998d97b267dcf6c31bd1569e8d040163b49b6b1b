sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/UIComponent",                                                                                                                                                                                                                                 
    "sap/ui/core/routing/HashChanger"                                                                                                                                                                                                                          
], function (UIComponent, HashChanger) {                                                                                                                                                                                                                       
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    return UIComponent.extend("cm05ovp.Component", {                                                                                                                                                                                                           
        metadata: {                                                                                                                                                                                                                                            
            manifest: "json"                                                                                                                                                                                                                                   
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        init: function () {                                                                                                                                                                                                                                    
            UIComponent.prototype.init.apply(this, arguments);                                                                                                                                                                                                 
            // 라우터가 없는 앱이라 주소 해시 감시를 직접 시작한다                                                                                                                                                                                                                   
            // (FLP 안에서는 이미 초기화돼 있어 중복 호출돼도 무해)                                                                                                                                                                                                                
            HashChanger.getInstance().init();                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            