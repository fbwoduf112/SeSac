sap.ui.define([], function () {                                                                                                                                                                                                                                
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    // CM05 (zcm05ovp) 는 같은 서버의 BSP 앱이라 상대 경로로 연다                                                                                                                                                                                                              
    var CM05_PATH = "/sap/bc/ui5_ui5/sap/zcm05ovp/index.html";                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
        onOpenCM05: function () {                                                                                                                                                                                                                              
            var sClient = new URLSearchParams(window.location.search).get("sap-client") || "100";                                                                                                                                                              
            var sUrl = CM05_PATH + "?sap-client=" + sClient + "&sap-ui-language=KO";                                                                                                                                                                           
            window.open(sUrl, "_blank");                                                                                                                                                                                                                       
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            