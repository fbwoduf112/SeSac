<mvc:View xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"                                                                                                                                                                                   
          controllerName="cm05ovp.view.Main" height="100%">                                                                                                                                                                                                    
    <Page title="Exception 통계 개요" showNavButton="false">                                                                                                                                                                                                       
        <customHeader>                                                                                                                                                                                                                                         
            <OverflowToolbar id="hdrBar" height="3.5rem">                                                                                                                                                                                                      
                <Avatar id="logo" displayShape="Square" displaySize="Custom"                                                                                                                                                                                   
                    customDisplaySize="3rem" imageFitType="Contain"                                                                                                                                                                                            
                    backgroundColor="Transparent"/>                                                                                                                                                                                                            
                <Title id="hdrBrand" text="떡잎반도체" class="zBrand"/>                                                                                                                                                                                             
                <ToolbarSeparator id="hdrSep"/>                                                                                                                                                                                                                
                <Title id="hdrTitle" text="Exception 통계" class="zScr"/>                                                                                                                                                                                        
            </OverflowToolbar>                                                                                                                                                                                                                                 
        </customHeader>                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
        <subHeader>                                                                                                                                                                                                                                            
            <OverflowToolbar>                                                                                                                                                                                                                                  
                <Label text="생성월"/>                                                                                                                                                                                                                            
                <MultiComboBox id="f_crmon" width="10rem" items="{f>/crmon}"                                                                                                                                                                                   
                               selectionFinish=".onFilterChange">                                                                                                                                                                                              
                    <core:Item key="{f>key}" text="{f>text}"/>                                                                                                                                                                                                 
                </MultiComboBox>                                                                                                                                                                                                                               
                <Label text="담당그룹"/>                                                                                                                                                                                                                           
                <MultiComboBox id="f_owgrp" width="10rem" items="{f>/owgrp}"                                                                                                                                                                                   
                               selectionFinish=".onFilterChange">                                                                                                                                                                                              
                    <core:Item key="{f>key}" text="{f>text}"/>                                                                                                                                                                                                 
                </MultiComboBox>                                                                                                                                                                                                                               
                <Label text="유형"/>                                                                                                                                                                                                                             
                <MultiComboBox id="f_extyp" width="10rem" items="{f>/extyp}"                                                                                                                                                                                   
                               selectionFinish=".onFilterChange">                                                                                                                                                                                              
                    <core:Item key="{f>key}" text="{f>text}"/>                                                                                                                                                                                                 
                </MultiComboBox>                                                                                                                                                                                                                               
                <Label text="발생출처"/>                                                                                                                                                                                                                           
                <MultiComboBox id="f_srtyp" width="10rem" items="{f>/srtyp}"                                                                                                                                                                                   
                               selectionFinish=".onFilterChange">                                                                                                                                                                                              
                    <core:Item key="{f>key}" text="{f>text}"/>                                                                                                                                                                                                 
                </MultiComboBox>                                                                                                                                                                                                                               
                <ToolbarSpacer/>                                                                                                                                                                                                                               
                <Button text="초기화" press=".onReset"/>                                                                                                                                                                                                          
            </OverflowToolbar>                                                                                                                                                                                                                                 
        </subHeader>                                                                                                                                                                                                                                           
        <content>                                                                                                                                                                                                                                              
            <VBox class="cm05Grid" renderType="Bare">                                                                                                                                                                                                          
                <VBox class="cm05Card cm05Wide" renderType="Bare">                                                                                                                                                                                             
                    <mvc:XMLView viewName="cm05ovp.ext.kpiCard.KpiCard"/>                                                                                                                                                                                      
                </VBox>                                                                                                                                                                                                                                        
                <VBox class="cm05Card" renderType="Bare">                                                                                                                                                                                                      
                    <Title class="cm05CardTitle" text="담당그룹별 현황"/>                                                                                                                                                                                             
                    <mvc:XMLView viewName="cm05ovp.ext.groupStatus.GroupStatus"/>                                                                                                                                                                              
                </VBox>                                                                                                                                                                                                                                        
                <VBox class="cm05Card cm05Wide" renderType="Bare">                                                                                                                                                                                             
                    <Title class="cm05CardTitle" text="발생출처별 현황"/>                                                                                                                                                                                             
                    <mvc:XMLView viewName="cm05ovp.ext.sourceTable.SourceTable"/>                                                                                                                                                                              
                </VBox>                                                                                                                                                                                                                                        
                <VBox class="cm05Card" renderType="Bare">                                                                                                                                                                                                      
                    <Title class="cm05CardTitle" text="바로 처리가 필요한 Exception"/>                                                                                                                                                                                 
                    <mvc:XMLView viewName="cm05ovp.ext.urgentList.UrgentList"/>                                                                                                                                                                                
                </VBox>                                                                                                                                                                                                                                        
                <VBox class="cm05Card" renderType="Bare">                                                                                                                                                                                                      
                    <Title class="cm05CardTitle" text="상태 분포"/>                                                                                                                                                                                                
                    <mvc:XMLView viewName="cm05ovp.ext.statusDonut.StatusDonut"/>                                                                                                                                                                              
                </VBox>                                                                                                                                                                                                                                        
                <VBox class="cm05Card" renderType="Bare">                                                                                                                                                                                                      
                    <Title class="cm05CardTitle" text="월별 비교"/>                                                                                                                                                                                                
                    <mvc:XMLView viewName="cm05ovp.ext.monthCompare.MonthCompare"/>                                                                                                                                                                            
                </VBox>                                                                                                                                                                                                                                        
            </VBox>                                                                                                                                                                                                                                            
        </content>                                                                                                                                                                                                                                             
    </Page>                                                                                                                                                                                                                                                    
</mvc:View>                                                                                                                                                                                                                                                    