sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/Controller",                                                                                                                                                                                                                              
    "sap/ui/model/json/JSONModel",                                                                                                                                                                                                                             
    "sap/ui/model/odata/v4/ODataModel",                                                                                                                                                                                                                        
    "cm05ovp/ext/common/FilterHelper"                                                                                                                                                                                                                          
], function (Controller, JSONModel, ODataModel, FilterHelper) {                                                                                                                                                                                                
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var SERVICE_URL = "/sap/opu/odata4/sap/zui_exception_stat_o4/srvd/sap/zui_exception_stat/0001/";                                                                                                                                                           
                                                                                                                                                                                                                                                               
    // 필터 필드 → 표시 텍스트 필드(없으면 코드 그대로)                                                                                                                                                                                                                           
    var FIELDS = [                                                                                                                                                                                                                                             
        { key: "crmon", text: null },                                                                                                                                                                                                                          
        { key: "owgrp", text: "OwgrpText" },                                                                                                                                                                                                                   
        { key: "extyp", text: "ExtypText" },                                                                                                                                                                                                                   
        { key: "srtyp", text: "SrtypText" }                                                                                                                                                                                                                    
    ];                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    return Controller.extend("cm05ovp.view.Main", {                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
        onInit: function () {                                                                                                                                                                                                                                  
            this.byId("logo").setSrc(sap.ui.require.toUrl("cm05ovp/img/logo.png"));                                                                                                                                                                            
            var oF = new JSONModel({ crmon: [], owgrp: [], extyp: [], srtyp: [] });                                                                                                                                                                            
            this.getView().setModel(oF, "f");                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            var oModel = new ODataModel({                                                                                                                                                                                                                      
                serviceUrl: SERVICE_URL,                                                                                                                                                                                                                       
                synchronizationMode: "None",                                                                                                                                                                                                                   
                operationMode: "Server",                                                                                                                                                                                                                       
                groupId: "$direct"                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            oModel.bindList("/ExceptionStat")                                                                                                                                                                                                                  
                .requestContexts(0, 1000)                                                                                                                                                                                                                      
                .then(function (aCtx) {                                                                                                                                                                                                                        
                    var aRows = aCtx.map(function (c) { return c.getObject(); });                                                                                                                                                                              
                    var oData = {};                                                                                                                                                                                                                            
                    FIELDS.forEach(function (f) {                                                                                                                                                                                                              
                        var m = {};                                                                                                                                                                                                                            
                        aRows.forEach(function (r) {                                                                                                                                                                                                           
                            if (r[f.key] !== undefined && r[f.key] !== "") {                                                                                                                                                                                   
                                m[r[f.key]] = f.text && r[f.text] ? r[f.text] : r[f.key];                                                                                                                                                                      
                            }                                                                                                                                                                                                                                  
                        });                                                                                                                                                                                                                                    
                        oData[f.key] = Object.keys(m).sort().map(function (k) {                                                                                                                                                                                
                            return { key: k, text: m[k] };                                                                                                                                                                                                     
                        });                                                                                                                                                                                                                                    
                    });                                                                                                                                                                                                                                        
                    oData.crmon.reverse(); // 최신 월이 위로                                                                                                                                                                                                         
                    oF.setData(oData);                                                                                                                                                                                                                         
                })                                                                                                                                                                                                                                             
                .catch(function (e) {                                                                                                                                                                                                                          
                    console.warn("[CM05] 필터 값 로딩 실패", e);                                                                                                                                                                                                      
                });                                                                                                                                                                                                                                            
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onFilterChange: function () {                                                                                                                                                                                                                          
            var mCond = {};                                                                                                                                                                                                                                    
            FIELDS.forEach(function (f) {                                                                                                                                                                                                                      
                var aKeys = this.byId("f_" + f.key).getSelectedKeys();                                                                                                                                                                                         
                if (aKeys.length) {                                                                                                                                                                                                                            
                    mCond[f.key] = aKeys.map(function (k) {                                                                                                                                                                                                    
                        return { operator: "EQ", values: [k] };                                                                                                                                                                                                
                    });                                                                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
            }.bind(this));                                                                                                                                                                                                                                     
            FilterHelper.publish(mCond);                                                                                                                                                                                                                       
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onReset: function () {                                                                                                                                                                                                                                 
            FIELDS.forEach(function (f) {                                                                                                                                                                                                                      
                this.byId("f_" + f.key).setSelectedKeys([]);                                                                                                                                                                                                   
            }.bind(this));                                                                                                                                                                                                                                     
            FilterHelper.publish({});                                                                                                                                                                                                                          
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               