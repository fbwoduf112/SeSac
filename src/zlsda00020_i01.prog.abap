"&---------------------------------------------------------------------*
"& Include          ZLSDA00020_I01
"&---------------------------------------------------------------------*
"& SD02 출고문서 생성 - PAI(사용자 입력 처리) 모듈 모음
"&
"& 화면 구성
"&   0100 : 출고대상 조회 (상단 판매오더 ALV + 하단 출고문서 ALV)
"&   0200 : 출고문서 Item 상세 팝업
"&   0300 : 판매오더 Item 상세 팝업
"&
"& 이동 규칙
"&   · 툴바 이동(SD01/SD03/SD04)은 PERFORM nav_go 로 처리하고 이동 이력을 남긴다.
"&   · BACK은 이력이 있으면 이전 화면으로, 없으면 기존 동작(LEAVE TO SCREEN 0).
"&   · LEAVE TO TRANSACTION 뒤의 코드는 실행되지 않으므로, 돌아왔을 때의 재조회는
"&     이 화면이 다시 시작될 때(START-OF-SELECTION)의 기본 조회가 대신한다.
"&---------------------------------------------------------------------*

"---------------------------------------------------------------------*
" LOAD-OF-PROGRAM
" 프로그램이 메모리에 올라올 때 가장 먼저 실행된다.
" 화면 이동으로 도착했는지 확인해서 이동 이력을 유지/삭제한다.
" (이 블록은 첫 번째 MODULE보다 위에 있어야 한다)
"---------------------------------------------------------------------*

LOAD-OF-PROGRAM.

  PERFORM nav_check_arrival.



  "---------------------------------------------------------------------*
  " EXIT_0100
  " 화면 0100의 BACK / EXIT / CANCEL 처리 (AT EXIT-COMMAND 모듈)
  " - BACK : 이동 이력이 있으면 이전 SD 화면, 없으면(첫 화면) 확인 후 종료
  " - EXIT : 확인 후 프로그램 종료
  " - CANC : 이동 이력이 있으면 이전 SD 화면, 없으면 확인 후 입력·결과 초기화(화면 유지)
  "---------------------------------------------------------------------*
MODULE exit_0100 INPUT.

  DATA:
    lv_has TYPE abap_bool,
    lv_yes TYPE abap_bool.

  PERFORM nav_has_history CHANGING lv_has.

  CASE sy-ucomm.

    WHEN 'BACK'.

      IF lv_has = abap_true.
        PERFORM leave_cleanup.
        PERFORM nav_back.
      ENDIF.

      PERFORM confirm_popup USING '019' CHANGING lv_yes.

      IF lv_yes = abap_true.
        PERFORM leave_cleanup.
        LEAVE TO SCREEN 0.
      ENDIF.

    WHEN 'EXIT'.

      PERFORM confirm_popup USING '019' CHANGING lv_yes.

      IF lv_yes = abap_true.
        PERFORM leave_cleanup.
        PERFORM nav_clear.
        LEAVE PROGRAM.
      ENDIF.

    WHEN 'CANC'.

      IF lv_has = abap_true.
        PERFORM leave_cleanup.
        PERFORM nav_back.
      ENDIF.

      PERFORM cancel_screen.

  ENDCASE.

ENDMODULE.



"---------------------------------------------------------------------*
" USER_COMMAND_0100
" 화면 0100의 버튼 처리
" SRCH : 출고대상 조회     CLER : 조건 초기화     REFR : 전체 새로고침
" SD01/SD03/SD04 : 다른 SD 프로그램으로 이동 (이동 이력 저장)
" SD02 : 현재 화면
"---------------------------------------------------------------------*
MODULE user_command_0100 INPUT.

  DATA:
  lv_sosta TYPE ztsda00010-sosta.


  "---------------------------------------------------------------------*
  " Function Code 저장
  "---------------------------------------------------------------------*
  gv_okcode = sy-ucomm.

  CLEAR sy-ucomm.


  "---------------------------------------------------------------------*
  " Function Code 처리
  "---------------------------------------------------------------------*
  CASE gv_okcode.


      "***********************************************************************
      " 검색
      "***********************************************************************
    WHEN 'SRCH'
      OR 'ENTER'.


      "---------------------------------------------------------------------*
      " 조회조건 검사
      "---------------------------------------------------------------------*
      PERFORM validate_search_condition.


      "---------------------------------------------------------------------*
      " 판매오더 조회
      "---------------------------------------------------------------------*
      PERFORM search_so.


      "---------------------------------------------------------------------*
      " 조회결과가 있을 경우
      "---------------------------------------------------------------------*
      IF gt_so IS NOT INITIAL.

        " 정상 조회


        "---------------------------------------------------------------------*
        " 조회결과가 없을 경우
        "---------------------------------------------------------------------*
      ELSE.


        "---------------------------------------------------------------------*
        " 판매오더번호를 직접 입력한 경우
        "---------------------------------------------------------------------*
        IF gv_s_vbeln IS NOT INITIAL.

          CLEAR lv_sosta.


          "---------------------------------------------------------------------*
          " Header 상태 확인
          "---------------------------------------------------------------------*
          SELECT SINGLE sosta
            FROM ztsda00010
            INTO @lv_sosta
          WHERE vbeln = @gv_s_vbeln.


          "---------------------------------------------------------------------*
          " 판매오더 자체가 존재하지 않음
          "---------------------------------------------------------------------*
          IF sy-subrc <> 0.

            MESSAGE s042(zmsga) WITH |판매오더 { gv_s_vbeln }| DISPLAY LIKE 'E'.


            "---------------------------------------------------------------------*
            " 판매오더는 존재함
            "---------------------------------------------------------------------*
          ELSE.

            CASE lv_sosta.


                "---------------------------------------------------------------------*
                " 이미 출고문서 생성
                "---------------------------------------------------------------------*
              WHEN 'DO'.

                MESSAGE s037(zmsga) WITH |{ gv_s_vbeln }(출고문서 생성)| '출고대상 조회' DISPLAY LIKE 'E'.


                "---------------------------------------------------------------------*
                " 출하 완료
                "---------------------------------------------------------------------*
              WHEN 'GI'.

                MESSAGE s037(zmsga) WITH |{ gv_s_vbeln }(출하 완료)| '출고대상 조회' DISPLAY LIKE 'E'.


                "---------------------------------------------------------------------*
                " 청구 완료
                "---------------------------------------------------------------------*
              WHEN 'BI'.

                MESSAGE s037(zmsga) WITH |{ gv_s_vbeln }(청구 완료)| '출고대상 조회' DISPLAY LIKE 'E'.


                "---------------------------------------------------------------------*
                " 취소
                "---------------------------------------------------------------------*
              WHEN 'CN'.

                MESSAGE s037(zmsga) WITH |{ gv_s_vbeln }(취소)| '출고대상 조회' DISPLAY LIKE 'E'.


                "---------------------------------------------------------------------*
                " 아직 SO 상태인데 결과가 없는 경우
                "---------------------------------------------------------------------*
              WHEN 'SO'.

                MESSAGE s041(zmsga) DISPLAY LIKE 'E'.


                "---------------------------------------------------------------------*
                " 기타 상태
                "---------------------------------------------------------------------*
              WHEN OTHERS.

                MESSAGE s036(zmsga) DISPLAY LIKE 'E'.

            ENDCASE.

          ENDIF.


          "---------------------------------------------------------------------*
          " 판매오더번호 미입력
          "---------------------------------------------------------------------*
        ELSE.

          MESSAGE s041(zmsga) DISPLAY LIKE 'E'.

        ENDIF.

      ENDIF.



      "***********************************************************************
      " 입력값 초기화
      "***********************************************************************
    WHEN 'CLER'.

      PERFORM clear_search_condition.



      "***********************************************************************
      " 전체 새로고침
      "***********************************************************************
    WHEN 'REFR'.

      "---------------------------------------------------------------------*
      " 수동 새로고침 시 강조 제거
      "---------------------------------------------------------------------*
      CLEAR gt_new_delivery.

      PERFORM refresh_screen.



      "***********************************************************************
      " 주문등록
      "***********************************************************************
    WHEN 'REGI'.

      CLEAR gt_new_delivery.

      PERFORM nav_go USING 'ZSD01'.



      "***********************************************************************
      " 판매오더
      "***********************************************************************
    WHEN 'SD01'.

      "---------------------------------------------------------------------*
      " 다른 화면 이동 시 강조 제거
      "---------------------------------------------------------------------*
      CLEAR gt_new_delivery.

      "---------------------------------------------------------------------*
      " 판매오더(SD01 조회 화면) 이동
      " LEAVE TO TRANSACTION을 직접 쓰지 않고 nav_go를 쓴다.
      " → 현재 화면을 이동 이력에 남겨서, 이동한 화면에서 BACK을 누르면
      "   이 화면으로 돌아온다.
      " (ZSD01L = 주문등록 화면을 건너뛰고 판매오더 조회 0200으로 바로 진입)
      " 돌아왔을 때의 재조회는 이 화면이 다시 시작될 때 수행된다.
      "---------------------------------------------------------------------*
      PERFORM nav_go USING 'ZSD01L'.



      "***********************************************************************
      " 출고문서
      "***********************************************************************
    WHEN 'SD02'.

      " 현재 화면



      "***********************************************************************
      " 출하처리
      "***********************************************************************
    WHEN 'SD03'.

      "---------------------------------------------------------------------*
      " 다른 화면 이동 시 강조 제거
      "---------------------------------------------------------------------*
      " SD03으로 넘길 방금 생성 문서 번호를 ABAP 메모리에 저장
      " (SD03이 시작할 때 IMPORT 해서 노란색으로 강조함)
      EXPORT gt_new_delivery = gt_new_delivery TO MEMORY ID 'ZSD_NEW_DL'.

      CLEAR gt_new_delivery.

      "---------------------------------------------------------------------*
      " 출하처리 이동
      " LEAVE TO TRANSACTION을 직접 쓰지 않고 nav_go를 쓴다.
      " → 현재 화면을 이동 이력에 남겨서, 이동한 화면에서 BACK을 누르면
      "   이 화면으로 돌아온다.
      " (방금 생성한 출고문서 번호는 위에서 메모리 ID ZSD_NEW_DL로 넘겼다.
      "  SD03이 시작할 때 읽어서 노란색으로 강조한다.)
      "---------------------------------------------------------------------*
      PERFORM nav_go USING 'ZSD03'.



      "***********************************************************************
      " 청구
      "***********************************************************************
    WHEN 'SD04'.

      "---------------------------------------------------------------------*
      " 다른 화면 이동 시 강조 제거
      "---------------------------------------------------------------------*
      CLEAR gt_new_delivery.

      "---------------------------------------------------------------------*
      " 청구 이동
      " LEAVE TO TRANSACTION을 직접 쓰지 않고 nav_go를 쓴다.
      " → 현재 화면을 이동 이력에 남겨서, 이동한 화면에서 BACK을 누르면
      "   이 화면으로 돌아온다.
      "---------------------------------------------------------------------*
      PERFORM nav_go USING 'ZSD04'.

  ENDCASE.

  CLEAR gv_okcode.

ENDMODULE.


"---------------------------------------------------------------------*
" EXIT_0200 (출고문서 Item 상세 팝업)
" 팝업 닫기. Item ALV / Container를 해제하고 데이터를 비운 뒤 0100으로 복귀.
" (팝업은 화면 이동이 아니므로 이동 이력과 무관하다)
"---------------------------------------------------------------------*
MODULE exit_0200 INPUT.

  CASE sy-ucomm.

    WHEN 'BACK'
      OR 'EXIT'
      OR 'CANC'.

      IF go_de_item_grid IS BOUND.
        CALL METHOD go_de_item_grid->free.
        FREE go_de_item_grid.
      ENDIF.

      IF go_de_item_container IS BOUND.
        CALL METHOD go_de_item_container->free.
        FREE go_de_item_container.
      ENDIF.

      CLEAR:
        gt_de_item,
        gs_de_item,
        gv_de_vbeln.

      LEAVE TO SCREEN 0.

  ENDCASE.

ENDMODULE.


"---------------------------------------------------------------------*
" EXIT_0300 (판매오더 Item 상세 팝업)
" 팝업 닫기. 팝업 ALV / Container를 해제하고 데이터를 비운다.
"---------------------------------------------------------------------*
MODULE exit_0300 INPUT.

  CASE sy-ucomm.

    WHEN 'BACK'
      OR 'EXIT'
      OR 'CANC'.


      "---------------------------------------------------------------------*
      " ALV Grid 제거
      "---------------------------------------------------------------------*
      IF go_so_item_grid IS BOUND.

        CALL METHOD go_so_item_grid->free.

        FREE go_so_item_grid.

      ENDIF.


      "---------------------------------------------------------------------*
      " Container 제거
      "---------------------------------------------------------------------*
      IF go_so_item_container IS BOUND.

        CALL METHOD go_so_item_container->free.

        FREE go_so_item_container.

      ENDIF.


      "---------------------------------------------------------------------*
      " 상세정보 초기화
      "---------------------------------------------------------------------*
      CLEAR:
        gt_so_item_detail,
        gs_so_item_detail,
        gv_so_vbeln_detail.


      "---------------------------------------------------------------------*
      " 팝업 종료
      "---------------------------------------------------------------------*
      LEAVE TO SCREEN 0.

  ENDCASE.

ENDMODULE.



"---------------------------------------------------------------------*
" F4_KUNNR
" 화면 0100 고객번호 필드의 F4 (PROCESS ON VALUE-REQUEST)
"---------------------------------------------------------------------*
MODULE f4_kunnr INPUT.

  PERFORM f4_kunnr_cust.

ENDMODULE.



"---------------------------------------------------------------------*
" F4_VBELN
" 화면 0100 판매오더번호 필드의 F4 (PROCESS ON VALUE-REQUEST)
"---------------------------------------------------------------------*
MODULE f4_vbeln INPUT.

  PERFORM f4_vbeln_so.

ENDMODULE.
