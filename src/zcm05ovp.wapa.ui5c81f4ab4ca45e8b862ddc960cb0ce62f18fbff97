sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/model/Filter",                                                                                                                                                                                                                                     
    "sap/ui/model/FilterOperator"                                                                                                                                                                                                                              
], function (Filter, FilterOperator) {                                                                                                                                                                                                                         
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var OP = {                                                                                                                                                                                                                                                 
        EQ: FilterOperator.EQ, EEQ: FilterOperator.EQ, NE: FilterOperator.NE,                                                                                                                                                                                  
        GT: FilterOperator.GT, LT: FilterOperator.LT,                                                                                                                                                                                                          
        GE: FilterOperator.GE, LE: FilterOperator.LE,                                                                                                                                                                                                          
        Contains: FilterOperator.Contains, StartsWith: FilterOperator.StartsWith,                                                                                                                                                                              
        EndsWith: FilterOperator.EndsWith                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    var aSubs = [];                                                                                                                                                                                                                                            
    var mCurrent = {};                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    // 조건 → OData Filter 배열 (필드 사이 AND, 같은 필드 안 OR)                                                                                                                                                                                                            
    function toFilters(mCond, aExclude) {                                                                                                                                                                                                                      
        var aAnd = [];                                                                                                                                                                                                                                         
        Object.keys(mCond || {}).forEach(function (sProp) {                                                                                                                                                                                                    
            if (aExclude && aExclude.indexOf(sProp) >= 0) { return; }                                                                                                                                                                                          
            var aOr = [];                                                                                                                                                                                                                                      
            (mCond[sProp] || []).forEach(function (c) {                                                                                                                                                                                                        
                var v = c.values || [];                                                                                                                                                                                                                        
                if (c.operator === "BT" && v.length === 2) {                                                                                                                                                                                                   
                    aOr.push(new Filter(sProp, FilterOperator.BT, v[0], v[1]));                                                                                                                                                                                
                } else if (OP[c.operator] && v.length) {                                                                                                                                                                                                       
                    aOr.push(new Filter(sProp, OP[c.operator], v[0]));                                                                                                                                                                                         
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
            if (aOr.length === 1) {                                                                                                                                                                                                                            
                aAnd.push(aOr[0]);                                                                                                                                                                                                                             
            } else if (aOr.length > 1) {                                                                                                                                                                                                                       
                aAnd.push(new Filter({ filters: aOr, and: false }));                                                                                                                                                                                           
            }                                                                                                                                                                                                                                                  
        });                                                                                                                                                                                                                                                    
        return aAnd;                                                                                                                                                                                                                                           
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
        toFilters: toFilters,                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        // 카드가 구독: 등록 즉시 현재 조건으로 한 번 호출, 이후 필터가 바뀔 때마다 호출                                                                                                                                                                                                      
        subscribe: function (fnApply) {                                                                                                                                                                                                                        
            aSubs.push(fnApply);                                                                                                                                                                                                                               
            fnApply(toFilters(mCurrent), mCurrent);                                                                                                                                                                                                            
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // 메인 뷰의 필터바가 호출                                                                                                                                                                                                                                       
        publish: function (mCond) {                                                                                                                                                                                                                            
            mCurrent = mCond || {};                                                                                                                                                                                                                            
            console.log("[CM05 filter]", JSON.stringify(mCurrent));                                                                                                                                                                                            
            aSubs.forEach(function (fn) { fn(toFilters(mCurrent), mCurrent); });                                                                                                                                                                               
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            