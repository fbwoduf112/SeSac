<mvc:View                                                                                                                                                                                                                                                      
    controllerName="com.zmm.grscan.zmmgrscan.controller.Z102_SCANNER"                                                                                                                                                                                          
    xmlns:mvc="sap.ui.core.mvc"                                                                                                                                                                                                                                
    xmlns="sap.m"                                                                                                                                                                                                                                              
    xmlns:core="sap.ui.core">                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
    <Page id="page" enableScrolling="true" class="grPage">                                                                                                                                                                                                     
        <!-- <customHeader>                                                                                                                                                                                                                                    
            <Bar class="grTopBar">                                                                                                                                                                                                                             
                <contentLeft>                                                                                                                                                                                                                                  
                    <Title text="떡잎반도체 입고 관리" level="H3"/>                                                                                                                                                                                                     
                </contentLeft>                                                                                                                                                                                                                                 
                <contentRight>                                                                                                                                                                                                                                 
                    <Text text="바코드로 간편하게"/>                                                                                                                                                                                                                   
                </contentRight>                                                                                                                                                                                                                                
            </Bar>                                                                                                                                                                                                                                             
        </customHeader> -->                                                                                                                                                                                                                                    
        <customHeader>                                                                                                                                                                                                                                         
    <OverflowToolbar id="hdrBar" height="3.5rem">                                                                                                                                                                                                              
        <Avatar id="logo" displayShape="Square" displaySize="Custom"                                                                                                                                                                                           
            customDisplaySize="3rem" imageFitType="Contain"                                                                                                                                                                                                    
            backgroundColor="Transparent"/>                                                                                                                                                                                                                    
        <Title id="hdrBrand" text="떡잎반도체" class="zBrand"/>                                                                                                                                                                                                     
        <ToolbarSeparator id="hdrSep"/>                                                                                                                                                                                                                        
        <Title id="hdrTitle" text="입고 스캐너" class="zScr"/>                                                                                                                                                                                                      
    </OverflowToolbar>                                                                                                                                                                                                                                         
</customHeader>                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
        <content>                                                                                                                                                                                                                                              
            <VBox class="grContent sapUiResponsiveContentPadding">                                                                                                                                                                                             
                <VBox class="grHero">                                                                                                                                                                                                                          
                    <HBox alignItems="Center" class="grEyebrow">                                                                                                                                                                                               
                        <core:Icon src="sap-icon://shipping-status" size="1rem"/>                                                                                                                                                                              
                        <Text text="떡잎반도체"/>                                                                                                                                                                                                                   
                    </HBox>                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    <Title text="입고 처리 프로그램" level="H1" class="grHeroTitle"/>                                                                                                                                                                                  
                    <Text                                                                                                                                                                                                                                      
                        text="카메라에 QR코드 또는 바코드를 비추면 자동으로 인식합니다."                                                                                                                                                                                               
                        wrapping="true"/>                                                                                                                                                                                                                      
                </VBox>                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                <VBox alignItems="Center" class="grScannerCard">                                                                                                                                                                                               
                    <core:Icon src="sap-icon://bar-code" size="3rem" class="grScannerIcon"/>                                                                                                                                                                   
                    <Title text="바코드를 카메라에 비춰 주세요" level="H3"/>                                                                                                                                                                                                
                    <Text text="촬영 버튼 없이 자동으로 읽어요" class="grMutedText"/>                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                    <Button                                                                                                                                                                                                                                    
                        text="입고 진행하기 · 카메라 켜기"                                                                                                                                                                                                                
                        icon="sap-icon://camera"                                                                                                                                                                                                               
                        type="Emphasized"                                                                                                                                                                                                                      
                        width="100%"                                                                                                                                                                                                                           
                        press=".onStartScan"                                                                                                                                                                                                                   
                        class="grPrimaryButton"/>                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                    <Input                                                                                                                                                                                                                                     
                        value="{scan>/barcode}"                                                                                                                                                                                                                
                        placeholder="직접 입력 예: 4500000010|00010"                                                                                                                                                                                                
                        width="100%"                                                                                                                                                                                                                           
                        class="grManualInput"/>                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                    <Button                                                                                                                                                                                                                                    
                        text="직접 입력값 적용"                                                                                                                                                                                                                       
                        width="100%"                                                                                                                                                                                                                           
                        press=".onApplyManualBarcode"                                                                                                                                                                                                          
                        class="grManualButton"/>                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                    <Text                                                                                                                                                                                                                                      
                        text="카메라 접근을 허용해 주세요. 카메라가 안 되면 직접 입력도 가능합니다."                                                                                                                                                                                        
                        wrapping="true"                                                                                                                                                                                                                        
                        class="grHelpText"/>                                                                                                                                                                                                                   
                </VBox>                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                <Panel headerText="스캔 정보" class="grCard">                                                                                                                                                                                                      
                    <content>                                                                                                                                                                                                                                  
                        <HBox wrap="Wrap" justifyContent="SpaceBetween">                                                                                                                                                                                       
                            <VBox width="48%" class="grField">                                                                                                                                                                                                 
                                <Label text="발주번호"/>                                                                                                                                                                                                           
                                <Input value="{scan>/ebeln}" editable="false"/>                                                                                                                                                                                
                            </VBox>                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                            <VBox width="48%" class="grField">                                                                                                                                                                                                 
                                <Label text="품목번호"/>                                                                                                                                                                                                           
                                <Input value="{scan>/ebelp}" editable="false"/>                                                                                                                                                                                
                            </VBox>                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                            <VBox width="100%" class="grField">                                                                                                                                                                                                
                                <Label text="입고 수량"/>                                                                                                                                                                                                          
                                <Input value="{scan>/quantity}" type="Number" placeholder="수량을 입력하세요"/>                                                                                                                                                        
                            </VBox>                                                                                                                                                                                                                            
                        </HBox>                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                        <Button                                                                                                                                                                                                                                
                            text="대기열에 추가"                                                                                                                                                                                                                     
                            icon="sap-icon://add"                                                                                                                                                                                                              
                            type="Emphasized"                                                                                                                                                                                                                  
                            width="100%"                                                                                                                                                                                                                       
                            press=".onAddQueue"                                                                                                                                                                                                                
                            class="grQueueAddButton"/>                                                                                                                                                                                                         
                    </content>                                                                                                                                                                                                                                 
                </Panel>                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="grQueueTitle">                                                                                                                                                                  
                    <Title text="입고 대기열" level="H2"/>                                                                                                                                                                                                          
                    <ObjectStatus text="{queue>/count}건" state="Information"/>                                                                                                                                                                                 
                </HBox>                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                <Table                                                                                                                                                                                                                                         
                    items="{queue>/items}"                                                                                                                                                                                                                     
                    noDataText="입고 대기 중인 바코드가 없어요."                                                                                                                                                                                                            
                    class="grQueueTable">                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                    <columns>                                                                                                                                                                                                                                  
                        <Column>                                                                                                                                                                                                                               
                            <Text text="발주번호"/>                                                                                                                                                                                                                
                        </Column>                                                                                                                                                                                                                              
                        <Column>                                                                                                                                                                                                                               
                            <Text text="품목"/>                                                                                                                                                                                                                  
                        </Column>                                                                                                                                                                                                                              
                        <Column hAlign="End">                                                                                                                                                                                                                  
                            <Text text="수량"/>                                                                                                                                                                                                                  
                        </Column>                                                                                                                                                                                                                              
                        <Column hAlign="Center" width="3rem"/>                                                                                                                                                                                                 
                    </columns>                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                    <items>                                                                                                                                                                                                                                    
                        <ColumnListItem vAlign="Middle">                                                                                                                                                                                                       
                            <cells>                                                                                                                                                                                                                            
                                <Text text="{queue>ebeln}"/>                                                                                                                                                                                                   
                                <Text text="{queue>ebelp}"/>                                                                                                                                                                                                   
                                <Text text="{queue>quantity}"/>                                                                                                                                                                                                
                                <Button                                                                                                                                                                                                                        
                                    icon="sap-icon://decline"                                                                                                                                                                                                  
                                    type="Transparent"                                                                                                                                                                                                         
                                    tooltip="대기열에서 제거"                                                                                                                                                                                                         
                                    press=".onDeleteQueue"/>                                                                                                                                                                                                   
                            </cells>                                                                                                                                                                                                                           
                        </ColumnListItem>                                                                                                                                                                                                                      
                    </items>                                                                                                                                                                                                                                   
                </Table>                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                <Button                                                                                                                                                                                                                                        
                    text="전체 처리 · 입고 컨펌"                                                                                                                                                                                                                       
                    icon="sap-icon://accept"                                                                                                                                                                                                                   
                    type="Emphasized"                                                                                                                                                                                                                          
                    enabled="{queue>/hasItems}"                                                                                                                                                                                                                
                    width="100%"                                                                                                                                                                                                                               
                    press=".onConfirm"                                                                                                                                                                                                                         
                    class="grConfirmButton"/>                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                <Text                                                                                                                                                                                                                                          
                    text="최종 입고 컨펌을 눌러야 SAP로 전송됩니다."                                                                                                                                                                                                           
                    wrapping="true"                                                                                                                                                                                                                            
                    class="grFooterText"/>                                                                                                                                                                                                                     
            </VBox>                                                                                                                                                                                                                                            
        </content>                                                                                                                                                                                                                                             
    </Page>                                                                                                                                                                                                                                                    
</mvc:View>                                                                                                                                                                                                                                                    