sap.ui.define([                                                                                                                                                                                                                                                
  "sap/m/Dialog", "sap/m/Button", "sap/m/Label", "sap/m/RadioButtonGroup", "sap/m/RadioButton",                                                                                                                                                                
  "sap/m/TextArea", "sap/m/Text", "sap/m/VBox", "sap/m/MessageToast", "sap/m/MessageBox"                                                                                                                                                                       
], function (Dialog, Button, Label, RadioButtonGroup, RadioButton, TextArea, Text, VBox,                                                                                                                                                                       
             MessageToast, MessageBox) {                                                                                                                                                                                                                       
  "use strict";                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
  function getNamespace(oModel) {                                                                                                                                                                                                                              
    return oModel.getMetaModel().requestObject("/$EntityContainer").then(function (s) {                                                                                                                                                                        
      return s.substring(0, s.lastIndexOf("."));                                                                                                                                                                                                               
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  function openDialog(oCtx, oModel, sExnum, sNs) {                                                                                                                                                                                                             
    // 0 = 이상 없음(OK), 1 = 이상 있음(NG), -1 = 미선택                                                                                                                                                                                                                  
    var oRes = new RadioButtonGroup({                                                                                                                                                                                                                          
      columns: 2, selectedIndex: -1,                                                                                                                                                                                                                           
      buttons: [new RadioButton({ text: "이상 없음" }), new RadioButton({ text: "이상 있음" })]                                                                                                                                                                        
    });                                                                                                                                                                                                                                                        
    var oResErr = new Text({ text: "" }).addStyleClass("sapUiTinyMarginTop");                                                                                                                                                                                  
    var oMemo = new TextArea({ width: "100%", rows: 3, maxLength: 200, placeholder: "확인 메모" });                                                                                                                                                                
                                                                                                                                                                                                                                                               
    function onOk() {                                                                                                                                                                                                                                          
      var i = oRes.getSelectedIndex();                                                                                                                                                                                                                         
      var sMemo = (oMemo.getValue() || "").trim();                                                                                                                                                                                                             
      var bOk = true;                                                                                                                                                                                                                                          
      if (i < 0) { oResErr.setText("확인 결과를 선택해 주세요."); bOk = false; } else { oResErr.setText(""); }                                                                                                                                                            
      if (!sMemo) {                                                                                                                                                                                                                                            
        oMemo.setValueState("Error"); oMemo.setValueStateText("확인 메모를 입력해 주세요."); bOk = false;                                                                                                                                                                 
      } else { oMemo.setValueState("None"); }                                                                                                                                                                                                                  
      if (!bOk) { return; }                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
      oDlg.setBusy(true);                                                                                                                                                                                                                                      
      var oOp = oModel.bindContext(sNs + ".confirmCheck(...)", oCtx);                                                                                                                                                                                          
      oOp.setParameter("chkres", i === 0 ? "OK" : "NG");                                                                                                                                                                                                       
      oOp.setParameter("memo", sMemo);                                                                                                                                                                                                                         
      oOp.execute().then(function () {                                                                                                                                                                                                                         
        oDlg.close();                                                                                                                                                                                                                                          
        oCtx.refresh();                                                                                                                                                                                                                                        
        MessageToast.show("확인이 완료되었습니다. 이제 2차 조치를 선택할 수 있어요.");                                                                                                                                                                                                
      }).catch(function (oErr) {                                                                                                                                                                                                                               
        oDlg.setBusy(false);                                                                                                                                                                                                                                   
        MessageBox.error((oErr && oErr.message) || "확인 처리에 실패했습니다.");                                                                                                                                                                                          
      });                                                                                                                                                                                                                                                      
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    var oDlg = new Dialog({                                                                                                                                                                                                                                    
      title: "확인 · " + sExnum,                                                                                                                                                                                                                                 
      contentWidth: "26rem",                                                                                                                                                                                                                                   
      content: [new VBox({                                                                                                                                                                                                                                     
        items: [                                                                                                                                                                                                                                               
          new Label({ text: "확인 결과", required: true }),                                                                                                                                                                                                        
          oRes, oResErr,                                                                                                                                                                                                                                       
          new Label({ text: "확인 메모", required: true }).addStyleClass("sapUiSmallMarginTop"),                                                                                                                                                                   
          oMemo                                                                                                                                                                                                                                                
        ]                                                                                                                                                                                                                                                      
      }).addStyleClass("sapUiSmallMargin")],                                                                                                                                                                                                                   
      beginButton: new Button({ text: "확인 완료", type: "Emphasized", press: onOk }),                                                                                                                                                                             
      endButton: new Button({ text: "취소", press: function () { oDlg.close(); } }),                                                                                                                                                                             
      afterClose: function () { oDlg.destroy(); }                                                                                                                                                                                                              
    });                                                                                                                                                                                                                                                        
    oDlg.open();                                                                                                                                                                                                                                               
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  return {                                                                                                                                                                                                                                                     
    onConfirm: function (oArg, aSelectedContexts) {                                                                                                                                                                                                            
      var oCtx = (oArg && oArg.getSource) ? oArg.getSource().getBindingContext() : oArg;                                                                                                                                                                       
      oCtx = oCtx || (aSelectedContexts && aSelectedContexts[0]);                                                                                                                                                                                              
      if (!oCtx) { MessageBox.error("대상 Exception 건을 찾지 못했습니다."); return; }                                                                                                                                                                                    
      var oModel = oCtx.getModel();                                                                                                                                                                                                                            
      Promise.all([oCtx.requestProperty("exnum"), getNamespace(oModel)])                                                                                                                                                                                       
        .then(function (a) { openDialog(oCtx, oModel, a[0], a[1]); });                                                                                                                                                                                         
    }                                                                                                                                                                                                                                                          
  };                                                                                                                                                                                                                                                           
});                                                                                                                                                                                                                                                            