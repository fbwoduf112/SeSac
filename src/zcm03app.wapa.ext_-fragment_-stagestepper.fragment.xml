<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">                                                                                                                                                                                               
  <VBox class="cm03Card">                                                                                                                                                                                                                                      
    <HBox class="cm03Stepper" alignItems="Start" justifyContent="SpaceBetween" width="100%">                                                                                                                                                                   
                                                                                                                                                                                                                                                               
      <!-- 1 접수 및 1차 조치 -->                                                                                                                                                                                                                                    
      <VBox class="cm03Step">                                                                                                                                                                                                                                  
        <core:Icon class="cm03Dot" size="2rem"                                                                                                                                                                                                                 
          src="{= ${prsta} === 'OPEN' ? 'sap-icon://inbox' : 'sap-icon://accept' }">                                                                                                                                                                           
          <core:customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                      
            value="{= ${prsta} === 'OPEN' ? 'current' : 'done' }"/></core:customData>                                                                                                                                                                          
        </core:Icon>                                                                                                                                                                                                                                           
        <Text class="cm03Label" text="접수 및 1차 조치">                                                                                                                                                                                                             
          <customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                           
            value="{= ${prsta} === 'OPEN' ? 'current' : 'done' }"/></customData>                                                                                                                                                                               
        </Text>                                                                                                                                                                                                                                                
      </VBox>                                                                                                                                                                                                                                                  
      <HBox class="cm03Line">                                                                                                                                                                                                                                  
        <layoutData><FlexItemData growFactor="1"/></layoutData>                                                                                                                                                                                                
        <customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                             
          value="{= ${prsta} === 'PROG' || ${prsta} === 'ACTN' || ${prsta} === 'CLSD' ? 'done' : 'todo' }"/></customData>                                                                                                                                      
      </HBox>                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
      <!-- 2 확인 -->                                                                                                                                                                                                                                            
      <VBox class="cm03Step">                                                                                                                                                                                                                                  
        <core:Icon class="cm03Dot" size="2rem"                                                                                                                                                                                                                 
          src="{= ${prsta} === 'ACTN' || ${prsta} === 'CLSD' ? 'sap-icon://accept' : 'sap-icon://employee' }">                                                                                                                                                 
          <core:customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                      
            value="{= ${prsta} === 'PROG' ? 'current' : (${prsta} === 'ACTN' || ${prsta} === 'CLSD' ? 'done' : 'todo') }"/></core:customData>                                                                                                                  
        </core:Icon>                                                                                                                                                                                                                                           
        <Text class="cm03Label" text="확인">                                                                                                                                                                                                                     
          <customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                           
            value="{= ${prsta} === 'PROG' ? 'current' : (${prsta} === 'ACTN' || ${prsta} === 'CLSD' ? 'done' : 'todo') }"/></customData>                                                                                                                       
        </Text>                                                                                                                                                                                                                                                
      </VBox>                                                                                                                                                                                                                                                  
      <HBox class="cm03Line">                                                                                                                                                                                                                                  
        <layoutData><FlexItemData growFactor="1"/></layoutData>                                                                                                                                                                                                
        <customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                             
          value="{= ${prsta} === 'ACTN' || ${prsta} === 'CLSD' ? 'done' : 'todo' }"/></customData>                                                                                                                                                             
      </HBox>                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
      <!-- 3 2차 조치 -->                                                                                                                                                                                                                                         
      <VBox class="cm03Step">                                                                                                                                                                                                                                  
        <core:Icon class="cm03Dot" size="2rem"                                                                                                                                                                                                                 
          src="{= ${prsta} === 'CLSD' ? 'sap-icon://accept' : 'sap-icon://wrench' }">                                                                                                                                                                          
          <core:customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                      
            value="{= ${prsta} === 'ACTN' ? 'current' : (${prsta} === 'CLSD' ? 'done' : 'todo') }"/></core:customData>                                                                                                                                         
        </core:Icon>                                                                                                                                                                                                                                           
        <Text class="cm03Label" text="2차 조치">                                                                                                                                                                                                                  
          <customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                           
            value="{= ${prsta} === 'ACTN' ? 'current' : (${prsta} === 'CLSD' ? 'done' : 'todo') }"/></customData>                                                                                                                                              
        </Text>                                                                                                                                                                                                                                                
      </VBox>                                                                                                                                                                                                                                                  
      <HBox class="cm03Line">                                                                                                                                                                                                                                  
        <layoutData><FlexItemData growFactor="1"/></layoutData>                                                                                                                                                                                                
        <customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                             
          value="{= ${prsta} === 'CLSD' || ${hold_state} === 'RLSD' ? 'done' : 'todo' }"/></customData>                                                                                                                                                        
      </HBox>                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
      <!-- 3.5 지급보류 해제 (지급보류가 걸린 건에만 표시) -->                                                                                                                                                                                                                   
      <VBox class="cm03Step">                                                                                                                                                                                                                                  
        <customData><core:CustomData key="show" writeToDom="true"                                                                                                                                                                                              
          value="{= ${hold_state} === 'NONE' ? 'off' : 'on' }"/></customData>                                                                                                                                                                                  
        <core:Icon class="cm03Dot" size="2rem"                                                                                                                                                                                                                 
          src="{= ${hold_state} === 'ACTV' ? 'sap-icon://locked' : 'sap-icon://unlocked' }"                                                                                                                                                                    
          tooltip="{= ${hold_state} === 'ACTV' ? (${prsta} === 'ACTN' ? '지급보류 중 · [지급보류 해제]를 눌러 해제하세요' : '2차 조치 후 해제할 수 있어요') : '지급보류가 해제되었어요' }">                                                                                                             
          <core:customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                      
            value="{= ${hold_state} === 'ACTV'                                                                                                                                                                                                                 
          ? (${prsta} === 'ACTN' &amp;&amp; ${path:'__OperationControl/releaseHold', targetType:'any'} !== false ? 'hold' : 'todo')                                                                                                                            
          : 'done' }"/></core:customData>                                                                                                                                                                                                                      
        </core:Icon>                                                                                                                                                                                                                                           
        <Text class="cm03Label" text="지급보류 해제">                                                                                                                                                                                                                
          <customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                           
            value="{= ${hold_state} === 'ACTV'                                                                                                                                                                                                                 
          ? (${prsta} === 'ACTN' &amp;&amp; ${path:'__OperationControl/releaseHold', targetType:'any'} !== false ? 'hold' : 'todo')                                                                                                                            
          : 'done' }"/></customData>                                                                                                                                                                                                                           
        </Text>                                                                                                                                                                                                                                                
      </VBox>                                                                                                                                                                                                                                                  
      <HBox class="cm03Line">                                                                                                                                                                                                                                  
        <layoutData><FlexItemData growFactor="1"/></layoutData>                                                                                                                                                                                                
        <customData>                                                                                                                                                                                                                                           
          <core:CustomData key="state" writeToDom="true"                                                                                                                                                                                                       
            value="{= ${prsta} === 'CLSD' ? 'done' : 'todo' }"/>                                                                                                                                                                                               
          <core:CustomData key="show" writeToDom="true"                                                                                                                                                                                                        
            value="{= ${hold_state} === 'NONE' ? 'off' : 'on' }"/>                                                                                                                                                                                             
        </customData>                                                                                                                                                                                                                                          
      </HBox>                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
      <!-- 4 종결 / 반려 -->                                                                                                                                                                                                                                       
      <VBox class="cm03Step">                                                                                                                                                                                                                                  
        <core:Icon class="cm03Dot" size="2rem"                                                                                                                                                                                                                 
          src="{= ${prsta} === 'RJCT' ? 'sap-icon://decline' : 'sap-icon://accept' }">                                                                                                                                                                         
          <core:customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                      
            value="{= ${prsta} === 'CLSD' ? 'done' : (${prsta} === 'RJCT' ? 'rejected' : 'todo') }"/></core:customData>                                                                                                                                        
        </core:Icon>                                                                                                                                                                                                                                           
        <Text class="cm03Label" text="{= ${prsta} === 'RJCT' ? '반려' : '종결' }">                                                                                                                                                                                 
          <customData><core:CustomData key="state" writeToDom="true"                                                                                                                                                                                           
            value="{= ${prsta} === 'CLSD' ? 'done' : (${prsta} === 'RJCT' ? 'rejected' : 'todo') }"/></customData>                                                                                                                                             
        </Text>                                                                                                                                                                                                                                                
      </VBox>                                                                                                                                                                                                                                                  
    </HBox>                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
    <!-- 다음 할 일 + 버튼 -->                                                                                                                                                                                                                                       
    <HBox class="cm03NextRow" alignItems="Center" justifyContent="SpaceBetween">                                                                                                                                                                               
  <VBox>                                                                                                                                                                                                                                                       
    <Text class="cm03NextLabel"                                                                                                                                                                                                                                
      text="{= ${prsta} === 'CLSD' || ${prsta} === 'RJCT' ? '처리 결과' : '다음 할 일' }"/>                                                                                                                                                                            
    <Text class="cm03Next"                                                                                                                                                                                                                                     
 text="{= ${prsta} === 'OPEN' ? '[확인]을 눌러 내용을 확인하세요'                                                                                                                                                                                                           
        : ${prsta} === 'PROG' ? '[2차 조치]를 선택해 주세요'                                                                                                                                                                                                             
        : ${prsta} === 'ACTN' &amp;&amp; ${path:'__OperationControl/close', targetType:'any'} === false ? '회계팀 처리가 완료되면 진행할 수 있어요'                                                                                                                             
        : ${prsta} === 'ACTN' &amp;&amp; ${hold_state} === 'ACTV' ? '후속 처리가 끝났다면 [지급보류 해제]를 먼저 하세요. 그다음 [재검증]하세요'                                                                                                                                              
        : ${prsta} === 'ACTN' &amp;&amp; ${hold_state} === 'RLSD' ? '[재검증] 또는 [종료]하세요'                                                                                                                                                                         
        : ${prsta} === 'ACTN' ? '후속 처리가 끝나면 [재검증]하세요. 필요 없으면 [종료]하세요'                                                                                                                                                                                          
        : ${prsta} === 'CLSD' ? '종결된 건입니다' : '반려된 건입니다' }"/>                                                                                                                                                                                                   
  </VBox>                                                                                                                                                                                                                                                      
  <HBox class="cm03Btns" alignItems="Center">                                                                                                                                                                                                                  
  <Button class="cm03Act" text="확인" type="Emphasized" icon="sap-icon://accept"                                                                                                                                                                                 
    core:require="{ ConfirmDialog: 'cm03app/ext/controller/ConfirmDialog' }"                                                                                                                                                                                   
    press="ConfirmDialog.onConfirm($event)">                                                                                                                                                                                                                   
    <customData><core:CustomData key="show" writeToDom="true"                                                                                                                                                                                                  
      value="{= ${prsta} === 'OPEN' ? 'on' : 'off' }"/></customData>                                                                                                                                                                                           
  </Button>                                                                                                                                                                                                                                                    
  <Button class="cm03Act" text="2차 조치" type="Emphasized" icon="sap-icon://lightbulb"                                                                                                                                                                           
    core:require="{ DecideDialog: 'cm03app/ext/controller/DecideDialog' }"                                                                                                                                                                                     
    press="DecideDialog.onDecide($event)">                                                                                                                                                                                                                     
    <customData><core:CustomData key="show" writeToDom="true"                                                                                                                                                                                                  
      value="{= ${prsta} === 'PROG' ? 'on' : 'off' }"/></customData>                                                                                                                                                                                           
  </Button>                                                                                                                                                                                                                                                    
 <Button class="cm03Act" text="재검증" type="Emphasized" icon="sap-icon://refresh"                                                                                                                                                                                
    enabled="{= ${__OperationControl/recheck} !== false }"                                                                                                                                                                                                     
    core:require="{ StageActions: 'cm03app/ext/controller/StageActions' }"                                                                                                                                                                                     
    press="StageActions.onRecheck($event)">                                                                                                                                                                                                                    
    <customData><core:CustomData key="show" writeToDom="true"                                                                                                                                                                                                  
      value="{= ${prsta} === 'ACTN' ? 'on' : 'off' }"/></customData>                                                                                                                                                                                           
  </Button>                                                                                                                                                                                                                                                    
  <Button class="cm03Act cm03ActSub" text="지급보류 해제" icon="sap-icon://unlocked"                                                                                                                                                                                 
    enabled="{= ${__OperationControl/releaseHold} !== false }"                                                                                                                                                                                                 
    core:require="{ StageActions: 'cm03app/ext/controller/StageActions' }"                                                                                                                                                                                     
    press="StageActions.onReleaseHold($event)">                                                                                                                                                                                                                
    <customData><core:CustomData key="show" writeToDom="true"                                                                                                                                                                                                  
      value="{= ${prsta} === 'ACTN' &amp;&amp; ${hold_state} === 'ACTV' ? 'on' : 'off' }"/></customData>                                                                                                                                                       
  </Button>                                                                                                                                                                                                                                                    
  <Button class="cm03Act cm03ActSub" text="종료"                                                                                                                                                                                                                 
  enabled="{= ${path:'__OperationControl/close', targetType:'any'} !== false &amp;&amp; ${path:'hold_state', targetType:'any'} !== 'ACTV' }"                                                                                                                   
  core:require="{ StageActions: 'cm03app/ext/controller/StageActions' }"                                                                                                                                                                                       
  press="StageActions.onClose($event)">                                                                                                                                                                                                                        
    <customData><core:CustomData key="show" writeToDom="true"                                                                                                                                                                                                  
      value="{= ${prsta} === 'ACTN' ? 'on' : 'off' }"/></customData>                                                                                                                                                                                           
  </Button>                                                                                                                                                                                                                                                    
</HBox>                                                                                                                                                                                                                                                        
</HBox>                                                                                                                                                                                                                                                        
  </VBox>                                                                                                                                                                                                                                                      
</core:FragmentDefinition>                                                                                                                                                                                                                                     