sap.ui.define([                                                                                                                                                                                                                                                
  "sap/m/Dialog", "sap/m/Button", "sap/m/Label", "sap/m/ComboBox", "sap/m/TextArea",                                                                                                                                                                           
  "sap/m/Text", "sap/m/Title", "sap/m/Popover", "sap/m/VBox", "sap/m/HBox", "sap/m/ObjectStatus",                                                                                                                                                              
  "sap/m/MessageToast", "sap/m/MessageBox", "sap/ui/core/ListItem"                                                                                                                                                                                             
], function (Dialog, Button, Label, ComboBox, TextArea, Text, Title, Popover, VBox, HBox,                                                                                                                                                                      
             ObjectStatus, MessageToast, MessageBox, ListItem) {                                                                                                                                                                                               
  "use strict";                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
  // 서비스에 노출된 조치 유형 값 도움말(VH)                                                                                                                                                                                                                                  
  var VH = {                                                                                                                                                                                                                                                   
    set:  "/ActionTypeVH",   // 엔티티셋                                                                                                                                                                                                                           
    key:  "ActionType",      // 조치 코드 (화면에는 표시하지 않음)                                                                                                                                                                                                           
    text: "ActionName",      // 조치명                                                                                                                                                                                                                            
    src:  "AllowedSrtyp"     // 허용 발생출처(SRTYP)                                                                                                                                                                                                                 
  };                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
  // 조치명 → 목록 아래 한 줄 설명 (코드는 화면에 쓰지 않고 이름으로 매칭)                                                                                                                                                                                                                
  var DESC = {                                                                                                                                                                                                                                                 
    "송장 재검증":    "입고·발주 기준으로 송장을 다시 맞춰 봄",                                                                                                                                                                                                                     
    "송장 취소":      "송장 자체가 잘못되어 취소함",                                                                                                                                                                                                                           
    "단가 차이 조정": "단가 차이 금액을 조정해서 지급함"                                                                                                                                                                                                                           
  };                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
  function getNamespace(oModel) {                                                                                                                                                                                                                              
    return oModel.getMetaModel().requestObject("/$EntityContainer").then(function (s) {                                                                                                                                                                        
      return s.substring(0, s.lastIndexOf("."));                                                                                                                                                                                                               
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  // 해당 Exception의 대기(WAIT) 후속 요청을 최신순으로 읽기                                                                                                                                                                                                                    
  function readWaitReq(oModel, oCtx) {                                                                                                                                                                                                                         
    var oLB = oModel.bindList("_Request", oCtx);                                                                                                                                                                                                               
    function done() { try { oLB.destroy(); } catch (e) { /* 이미 정리됨 */ } }                                                                                                                                                                                      
    return oLB.requestContexts(0, 100).then(function (aCtx) {                                                                                                                                                                                                  
      var aRows = aCtx.map(function (c) { return c.getObject(); }); // destroy 전에 값 복사                                                                                                                                                                         
      done();                                                                                                                                                                                                                                                  
      return aRows                                                                                                                                                                                                                                             
        .filter(function (r) { return r && r.rqsta === "WAIT"; })                                                                                                                                                                                              
        .sort(function (x, y) { return x.rqnum < y.rqnum ? 1 : -1; });                                                                                                                                                                                         
    }).catch(function (e) {                                                                                                                                                                                                                                    
      console.warn("[CM03] readWaitReq failed", e);                                                                                                                                                                                                            
      done();                                                                                                                                                                                                                                                  
      return [];                                                                                                                                                                                                                                               
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  // 처리 이력에서 '확인' 결과 한 줄을 찾는다: "[이상 없음] 메모" / "[이상 있음] 메모"                                                                                                                                                                                                     
  // (확인 액션이 이력 메모를 이 형식으로 저장한다는 전제. 없으면 null)                                                                                                                                                                                                                 
  function readConfirm(oModel, oCtx) {                                                                                                                                                                                                                         
    var oLB = oModel.bindList("_History", oCtx);                                                                                                                                                                                                               
    function done() { try { oLB.destroy(); } catch (e) { /* 이미 정리됨 */ } }                                                                                                                                                                                      
    return oLB.requestContexts(0, 200).then(function (aCtx) {                                                                                                                                                                                                  
      var aRows = aCtx.map(function (c) { return c.getObject(); });                                                                                                                                                                                            
      done();                                                                                                                                                                                                                                                  
      var oHit = null;                                                                                                                                                                                                                                         
      aRows.forEach(function (r) {                                                                                                                                                                                                                             
        Object.keys(r || {}).forEach(function (k) {                                                                                                                                                                                                            
          var m = typeof r[k] === "string" && r[k].match(/^\[(이상 없음|이상 있음)\]\s*(.*)$/);                                                                                                                                                                        
          if (m) { oHit = { result: m[1], memo: m[2] }; }   // 마지막으로 찾은 것을 사용                                                                                                                                                                                  
        });                                                                                                                                                                                                                                                    
      });                                                                                                                                                                                                                                                      
      return oHit;                                                                                                                                                                                                                                             
    }).catch(function (e) {                                                                                                                                                                                                                                    
      console.warn("[CM03] readConfirm failed", e);                                                                                                                                                                                                            
      done();                                                                                                                                                                                                                                                  
      return null;                                                                                                                                                                                                                                             
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  function loadCodes(oModel, sSrtyp) {                                                                                                                                                                                                                         
    // 서버 필터 대신 전체 조회 후 클라이언트에서 SRTYP로 거름 (메타데이터 타입 문제 회피)                                                                                                                                                                                                     
    return oModel.bindList(VH.set).requestContexts(0, 200).then(function (aCtx) {                                                                                                                                                                              
      var aRows = aCtx.map(function (c) { return c.getObject(); });                                                                                                                                                                                            
      if (!VH.src || !sSrtyp) { return aRows; }                                                                                                                                                                                                                
      return aRows.filter(function (r) {                                                                                                                                                                                                                       
        return String(r[VH.src] || "").trim() === sSrtyp;                                                                                                                                                                                                      
      });                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  function requestAi(oModel, oCtx, sNs) {                                                                                                                                                                                                                      
    var oOp = oModel.bindContext(sNs + ".getAiRecommend(...)", oCtx);                                                                                                                                                                                          
    return oOp.execute().then(function () {                                                                                                                                                                                                                    
      return Object.assign({}, oOp.getBoundContext().getObject());                                                                                                                                                                                             
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  function openDialog(oCtx, oModel, sExnum, sSrtyp, sNs) {                                                                                                                                                                                                     
    var sAiKey = "";      // AI 추천 코드                                                                                                                                                                                                                          
    var sAiHint = "";     // AI 추천 안내 문구 (수동으로 바꾸면 숨김)                                                                                                                                                                                                         
    var oHideTimer = null;                                                                                                                                                                                                                                     
    var oDotTimer = null;                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
    // ── 확인 결과 요약 (읽기 전용, 확인 이력이 있을 때만 표시) ──                                                                                                                                                                                                                 
    var oChkState = new ObjectStatus({ text: "", state: "None" });                                                                                                                                                                                             
    var oChkMemo = new Text({ text: "" }).addStyleClass("sapUiTinyMarginBegin");                                                                                                                                                                               
    var oChkBox = new HBox({ visible: false, alignItems: "Center", items: [oChkState, oChkMemo] });                                                                                                                                                            
    var oChkLabel = new Label({ text: "확인 결과", visible: false });                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    // ── 컨트롤 ──                                                                                                                                                                                                                                               
    var oHint = new Text({ text: "AI 추천을 불러오는 중…" }).addStyleClass("sapUiTinyMarginTop");                                                                                                                                                                      
    var oCombo = new ComboBox({ width: "100%", placeholder: "조치유형 선택", showSecondaryValues: true });                                                                                                                                                           
    var oBadge = new ObjectStatus({                                                                                                                                                                                                                            
      text: "AI 추천", icon: "sap-icon://lightbulb", state: "Information", visible: false                                                                                                                                                                        
    }).addStyleClass("sapUiTinyMarginTop");                                                                                                                                                                                                                    
    var oMemo = new TextArea({ width: "100%", rows: 3, maxLength: 200, placeholder: "조치 메모" });                                                                                                                                                                
    var oTarget = new Text({ text: "" }).addStyleClass("sapUiTinyMarginTop");                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
    // ── 호버 말풍선 (AI 근거) ──                                                                                                                                                                                                                                    
    var oWhyTitle = new Title({ text: "AI 추천 근거", level: "H5" });                                                                                                                                                                                              
    var oWhyText = new Text({ text: "" });                                                                                                                                                                                                                     
    var oWhyMeta = new Text({ text: "" }).addStyleClass("sapUiTinyMarginTop");                                                                                                                                                                                 
    var oWhy = new Popover({                                                                                                                                                                                                                                   
      showHeader: false, placement: "Right", contentWidth: "22rem",                                                                                                                                                                                            
      content: [new VBox({ items: [oWhyTitle, oWhyText, oWhyMeta] }).addStyleClass("sapUiSmallMargin")]                                                                                                                                                        
    });                                                                                                                                                                                                                                                        
    function isAiSelected() { return !!sAiKey && oCombo.getSelectedKey() === sAiKey; }                                                                                                                                                                         
    function showWhy(oOpener) {                                                                                                                                                                                                                                
      clearTimeout(oHideTimer);                                                                                                                                                                                                                                
      // AI 추천 코드가 선택돼 있을 때만 근거를 보여 준다                                                                                                                                                                                                                         
      if (isAiSelected() && !oWhy.isOpen()) { oWhy.openBy(oOpener); }                                                                                                                                                                                          
    }                                                                                                                                                                                                                                                          
    function hideWhySoon() {                                                                                                                                                                                                                                   
      clearTimeout(oHideTimer);                                                                                                                                                                                                                                
      oHideTimer = setTimeout(function () { if (oWhy.isOpen()) { oWhy.close(); } }, 150);                                                                                                                                                                      
    }                                                                                                                                                                                                                                                          
    [oCombo, oBadge].forEach(function (o) {                                                                                                                                                                                                                    
      o.addEventDelegate({                                                                                                                                                                                                                                     
        onmouseover: function () { showWhy(o); },                                                                                                                                                                                                              
        onmouseout:  hideWhySoon                                                                                                                                                                                                                               
      });                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
    // 선택한 조치에 맞춰 안내문·배지 갱신                                                                                                                                                                                                                                    
    function refreshTarget() {                                                                                                                                                                                                                                 
      var oItem = oCombo.getSelectedItem();                                                                                                                                                                                                                    
      if (!oItem) { oTarget.setText(""); return; }                                                                                                                                                                                                             
      var sName = oItem.getText();                                                                                                                                                                                                                             
      oTarget.setText(DESC[sName]                                                                                                                                                                                                                              
        ? "→ 회계팀 송장 처리 화면 '요청' 컬럼에 [" + sName + "]으로 전달됩니다."                                                                                                                                                                                                   
        : "→ 후속 처리 화면으로 전달됩니다.");                                                                                                                                                                                                                              
    }                                                                                                                                                                                                                                                          
    oCombo.attachSelectionChange(function () {                                                                                                                                                                                                                 
      oCombo.setValueState("None");                                                                                                                                                                                                                            
      var bAi = isAiSelected();                                                                                                                                                                                                                                
      oBadge.setVisible(bAi);                                                                                                                                                                                                                                  
      oHint.setText(bAi ? sAiHint : "");                 // 수동으로 바꾸면 'AI가 추천한…' 문구 제거                                                                                                                                                                          
      if (!bAi && oWhy.isOpen()) { oWhy.close(); }       // 근거 말풍선도 닫기                                                                                                                                                                                         
      refreshTarget();                                                                                                                                                                                                                                         
    });                                                                                                                                                                                                                                                        
    oMemo.attachLiveChange(function () { oMemo.setValueState("None"); });                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
    // ── 확정 ──                                                                                                                                                                                                                                                
    function onConfirm() {                                                                                                                                                                                                                                     
      var sKey = oCombo.getSelectedKey();                                                                                                                                                                                                                      
      var sMemo = (oMemo.getValue() || "").trim();                                                                                                                                                                                                             
      var bOk = true;                                                                                                                                                                                                                                          
      if (!sKey) {                                                                                                                                                                                                                                             
        oCombo.setValueState("Error");                                                                                                                                                                                                                         
        oCombo.setValueStateText("조치유형을 선택해 주세요.");                                                                                                                                                                                                            
        bOk = false;                                                                                                                                                                                                                                           
      }                                                                                                                                                                                                                                                        
      if (!sMemo) {                                                                                                                                                                                                                                            
        oMemo.setValueState("Error");                                                                                                                                                                                                                          
        oMemo.setValueStateText("조치 메모를 입력해 주세요.");                                                                                                                                                                                                            
        bOk = false;                                                                                                                                                                                                                                           
      }                                                                                                                                                                                                                                                        
      if (!bOk) { return; }                                                                                                                                                                                                                                    
      oDlg.setBusy(true);                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
      readWaitReq(oModel, oCtx).then(function (aBefore) {                                                                                                                                                                                                      
        var sBefore = aBefore.length ? aBefore[0].rqnum : "";                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        var oOp = oModel.bindContext(sNs + ".decideAction(...)", oCtx);                                                                                                                                                                                        
        oOp.setParameter("acttp", sKey);                                                                                                                                                                                                                       
        oOp.setParameter("memo", sMemo);                                                                                                                                                                                                                       
        oOp.setParameter("ai_acttp", sAiKey);   // 추천 코드 → 채택/거절 기록용                                                                                                                                                                                           
        return oOp.execute().then(function () {                                                                                                                                                                                                                
          oDlg.close();                                                                                                                                                                                                                                        
          // refresh 전에 먼저 읽는다 (갱신 중인 컨텍스트에 새 바인딩을 붙이지 않기 위해)                                                                                                                                                                                                  
          return readWaitReq(oModel, oCtx).then(function (aAfter) {                                                                                                                                                                                            
            oCtx.refresh();                                                                                                                                                                                                                                    
            var oNew = (aAfter.length && aAfter[0].rqnum !== sBefore) ? aAfter[0] : null;                                                                                                                                                                      
            if (oNew) {                                                                                                                                                                                                                                        
              MessageBox.information(                                                                                                                                                                                                                          
                "2차 조치 요청 " + oNew.rqnum + " (" + (oNew.acttp_text || "") + ")이(가)\n" +                                                                                                                                                                        
                "회계팀 처리 화면(" + oNew.tgpgm + ")에 전달되었습니다.\n" +                                                                                                                                                                                                  
                "해당 담당자에게 알림이 전달됩니다.",                                                                                                                                                                                                                         
                { title: "2차 조치 요청 전달" });                                                                                                                                                                                                                     
            } else {                                                                                                                                                                                                                                           
              MessageToast.show("2차 조치가 요청되었습니다.");                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
          });                                                                                                                                                                                                                                                  
        });                                                                                                                                                                                                                                                    
      }).catch(function (oErr) {                                                                                                                                                                                                                               
        oDlg.setBusy(false);                                                                                                                                                                                                                                   
        MessageBox.error((oErr && oErr.message) || "2차 조치 요청에 실패했습니다.");                                                                                                                                                                                       
      });                                                                                                                                                                                                                                                      
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    var oDlg = new Dialog({                                                                                                                                                                                                                                    
      title: "2차 조치 · " + sExnum,                                                                                                                                                                                                                              
      contentWidth: "28rem",                                                                                                                                                                                                                                   
      content: [                                                                                                                                                                                                                                               
        new VBox({                                                                                                                                                                                                                                             
          items: [                                                                                                                                                                                                                                             
            oChkLabel, oChkBox,                                                                                                                                                                                                                                
            new Label({ text: "조치유형", required: true, labelFor: oCombo }).addStyleClass("sapUiSmallMarginTop"),                                                                                                                                                
            oCombo, oBadge, oHint,                                                                                                                                                                                                                             
            new Label({ text: "조치 메모", required: true, labelFor: oMemo }).addStyleClass("sapUiSmallMarginTop"),                                                                                                                                                
            oMemo, oTarget                                                                                                                                                                                                                                     
          ]                                                                                                                                                                                                                                                    
        }).addStyleClass("sapUiSmallMargin")                                                                                                                                                                                                                   
      ],                                                                                                                                                                                                                                                       
      beginButton: new Button({ text: "2차 조치 요청", type: "Emphasized", press: onConfirm }),                                                                                                                                                                     
      endButton: new Button({ text: "취소", press: function () { oDlg.close(); } }),                                                                                                                                                                             
      afterClose: function () { clearTimeout(oHideTimer); clearInterval(oDotTimer); oWhy.destroy(); oDlg.destroy(); }                                                                                                                                          
    });                                                                                                                                                                                                                                                        
    oDlg.open();                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
    // 확인 결과 요약 (있을 때만)                                                                                                                                                                                                                                        
    readConfirm(oModel, oCtx).then(function (oChk) {                                                                                                                                                                                                           
      if (!oChk) { return; }                                                                                                                                                                                                                                   
      oChkState.setText(oChk.result);                                                                                                                                                                                                                          
      oChkState.setState(oChk.result === "이상 없음" ? "Success" : "Warning");                                                                                                                                                                                     
      oChkMemo.setText(oChk.memo);                                                                                                                                                                                                                             
      oChkLabel.setVisible(true);                                                                                                                                                                                                                              
      oChkBox.setVisible(true);                                                                                                                                                                                                                                
    });                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
    // ── 허용 코드 목록 + AI 추천 ──                                                                                                                                                                                                                                  
    var iDots = 0;                                                                                                                                                                                                                                             
    oCombo.setPlaceholder("AI 추천 분석 중…");                                                                                                                                                                                                                      
    oDotTimer = setInterval(function () {                                                                                                                                                                                                                      
      iDots = (iDots + 1) % 4;                                                                                                                                                                                                                                 
      oHint.setText("AI가 추천 조치를 분석하고 있어요" + ".".repeat(iDots === 0 ? 3 : iDots) +                                                                                                                                                                              
                    " 잠시만 기다려 주세요.");                                                                                                                                                                                                                          
    }, 400);                                                                                                                                                                                                                                                   
    function doneLoading() {                                                                                                                                                                                                                                   
      clearInterval(oDotTimer);                                                                                                                                                                                                                                
      oCombo.setPlaceholder("조치유형 선택");                                                                                                                                                                                                                        
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    loadCodes(oModel, sSrtyp).then(function (aCodes) {                                                                                                                                                                                                         
      aCodes.forEach(function (c) {                                                                                                                                                                                                                            
        var sName = c[VH.text] || c[VH.key];     // 코드 없이 이름만 표시                                                                                                                                                                                               
        oCombo.addItem(new ListItem({ key: c[VH.key], text: sName, additionalText: DESC[sName] || "" }));                                                                                                                                                      
      });                                                                                                                                                                                                                                                      
    }).catch(function () {                                                                                                                                                                                                                                     
      MessageToast.show("조치 코드 목록을 불러오지 못했습니다.");                                                                                                                                                                                                              
    }).then(function () {                                                                                                                                                                                                                                      
      return requestAi(oModel, oCtx, sNs);                                                                                                                                                                                                                     
    }).then(function (r) {                                                                                                                                                                                                                                     
      doneLoading();                                                                                                                                                                                                                                           
      if (r.success === "X" && r.acttp) {                                                                                                                                                                                                                      
        sAiKey = r.acttp;                                                                                                                                                                                                                                      
        if (!oCombo.getItemByKey(sAiKey)) {                                                                                                                                                                                                                    
          oCombo.addItem(new ListItem({ key: sAiKey, text: r.actnm || sAiKey, additionalText: DESC[r.actnm] || "" }));                                                                                                                                         
        }                                                                                                                                                                                                                                                      
        if (!oCombo.getSelectedKey()) {                                                                                                                                                                                                                        
          oCombo.setSelectedKey(sAiKey);                                                                                                                                                                                                                       
          oBadge.setVisible(true);                                                                                                                                                                                                                             
        }                                                                                                                                                                                                                                                      
        oWhyText.setText(r.reason || "근거 정보가 없습니다.");                                                                                                                                                                                                          
        oWhyMeta.setText("추천: " + (r.actnm || sAiKey) + " · 참고 사례 " + (r.cnt || 0) + "건");                                                                                                                                                                     
        sAiHint = "AI가 추천한 조치입니다. 조치유형이나 배지에 마우스를 올리면 근거를 볼 수 있어요.";                                                                                                                                                                                           
        oHint.setText(isAiSelected() ? sAiHint : "");                                                                                                                                                                                                          
        refreshTarget();                                                                                                                                                                                                                                       
      } else {                                                                                                                                                                                                                                                 
        oHint.setText("AI가 이번 건에 대한 추천을 만들지 못했어요. 직접 조치를 선택해 주세요.");                                                                                                                                                                                           
      }                                                                                                                                                                                                                                                        
    }).catch(function (oErr) {                                                                                                                                                                                                                                 
      doneLoading();                                                                                                                                                                                                                                           
      console.error("[CM03] getAiRecommend failed", oErr);                                                                                                                                                                                                     
      oHint.setText("AI 호출에 실패했어요(연결 오류). 직접 조치를 선택하거나 팝업을 닫고 다시 열어 주세요.");                                                                                                                                                                                    
    });                                                                                                                                                                                                                                                        
  }                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
  return {                                                                                                                                                                                                                                                     
    onDecide: function (oArg, aSelectedContexts) {                                                                                                                                                                                                             
      var oCtx = (oArg && oArg.getSource) ? oArg.getSource().getBindingContext() : oArg;                                                                                                                                                                       
      oCtx = oCtx || (aSelectedContexts && aSelectedContexts[0]);                                                                                                                                                                                              
      if (!oCtx) { MessageBox.error("대상 Exception 건을 찾지 못했습니다."); return; }                                                                                                                                                                                    
      var oModel = oCtx.getModel();                                                                                                                                                                                                                            
      oCtx.requestProperty("prsta").then(function (sSta) {                                                                                                                                                                                                     
        if (sSta !== "PROG") {                                                                                                                                                                                                                                 
          MessageToast.show("확인을 마친 상태에서만 2차 조치를 선택할 수 있습니다.");                                                                                                                                                                                                
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
        return Promise.all([oCtx.requestProperty("exnum"), oCtx.requestProperty("srtyp"), getNamespace(oModel)])                                                                                                                                               
          .then(function (a) { openDialog(oCtx, oModel, a[0], a[1], a[2]); });                                                                                                                                                                                 
      });                                                                                                                                                                                                                                                      
    }                                                                                                                                                                                                                                                          
  };                                                                                                                                                                                                                                                           
