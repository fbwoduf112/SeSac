sap.ui.define([                                                                                                                                                                                                                                                
  "sap/m/Dialog", "sap/m/Button", "sap/m/Table", "sap/m/Column",                                                                                                                                                                                               
  "sap/m/ColumnListItem", "sap/m/Text", "sap/m/Title", "sap/m/VBox", "sap/m/ScrollContainer"                                                                                                                                                                   
], function (Dialog, Button, Table, Column, ColumnListItem, Text, Title, VBox, ScrollContainer) {                                                                                                                                                              
  "use strict";                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
  function tbl(aHead, aRows) {                                                                                                                                                                                                                                 
    var oT = new Table({                                                                                                                                                                                                                                       
      width: "100%",                                                                                                                                                                                                                                           
      columns: aHead.map(function (h) { return new Column({ header: new Text({ text: h }) }); })                                                                                                                                                               
    });                                                                                                                                                                                                                                                        
    aRows.forEach(function (r) {                                                                                                                                                                                                                               
      oT.addItem(new ColumnListItem({ cells: r.map(function (c) { return new Text({ text: c }); }) }));                                                                                                                                                        
    });                                                                                                                                                                                                                                                        
    return oT;                                                                                                                                                                                                                                                 
  }                                                                                                                                                                                                                                                            
  function ttl(s) { return new Title({ text: s, level: "H4" }).addStyleClass("sapUiSmallMarginTop"); }                                                                                                                                                         
                                                                                                                                                                                                                                                               
  return {                                                                                                                                                                                                                                                     
    onShow: function () {                                                                                                                                                                                                                                      
      var oBox = new VBox({ items: [                                                                                                                                                                                                                           
        ttl("① 처리 순서"),                                                                                                                                                                                                                                        
        new Text({ text: "접수(OPEN) → 처리중(PROG) → 조치 실행(ACTN) → 종결(CLSD)\n[처리 시작] → [조치 결정] → [재검증] 또는 [종료]" }),                                                                                                                                                
                                                                                                                                                                                                                                                               
        ttl("② 버튼 설명"),                                                                                                                                                                                                                                        
        tbl(["버튼", "언제 누르나", "누르면"], [                                                                                                                                                                                                                         
          ["처리 시작", "새 Exception을 내가 맡을 때", "담당자가 나로 지정되고 '처리중'이 됩니다"],                                                                                                                                                                                        
          ["조치 결정", "원인을 보고 조치를 정할 때", "조치가 기록되고, 필요하면 담당 부서에 후속 요청이 생성됩니다"],                                                                                                                                                                                  
          ["AI 추천", "어떤 조치가 좋을지 모를 때", "유사 사례 기준 추천 조치를 보여줍니다 (결정은 직접)"],                                                                                                                                                                                      
          ["다른 담당자에게 넘기기", "내 업무가 아닐 때", "담당자만 바뀌고 상태는 그대로입니다"],                                                                                                                                                                                               
          ["반려", "Exception으로 볼 수 없을 때", "반려로 종료됩니다 (Hold가 있으면 먼저 해제)"],                                                                                                                                                                                       
          ["Hold 해제", "후속 요청 처리가 끝난 송장", "지급 보류가 풀립니다 (조치 실행 상태에서만)"],                                                                                                                                                                                         
          ["재검증", "조치 결과를 다시 확인할 때", "통과하면 자동 종결, 실패하면 '조치 실행' 유지"],                                                                                                                                                                                           
          ["종료", "조치가 끝나 마무리할 때", "종결되고 대기 중인 후속 요청은 취소됩니다"]                                                                                                                                                                                                   
        ]),                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        ttl("③ 후속 요청은 어디서 처리하나"),                                                                                                                                                                                                                              
        tbl(["조치", "처리 화면", "처리 방법"], [                                                                                                                                                                                                                        
          ["AP 금액 재산정 (APRC)", "ZFI02", "단가차이 HOLD 송장: [단가 차이 조정]"],                                                                                                                                                                                           
          ["INVOICE 재발행 요청 (REIS)", "ZFI02", "[송장 취소]"],                                                                                                                                                                                                       
          ["GR 수량 수정 (GRFX)", "MM03", "GR 수량 수정"],                                                                                                                                                                                                             
          ["재검증요청 (RCHK, 외주 재대사)", "MM04", "정합성 재업로드"],                                                                                                                                                                                                        
          ["반품 (RTRN)", "MM03", "반품 처리"],                                                                                                                                                                                                                      
          ["재작업 (RWRK)", "MM05", "재작업 처리"]                                                                                                                                                                                                                     
        ]),                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        ttl("④ 잠금 규칙"),                                                                                                                                                                                                                                        
        new Text({ text: "• 조치 결정 전에는 [Hold 해제]를 누를 수 없습니다.\n• 송장(INVC)은 후속 요청이 끝나기 전에는 [Hold 해제]·[재검증]·[종료]가 잠깁니다.\n• 순서: 후속 요청 완료 → [Hold 해제] → [재검증] 또는 [종료]" })                                                                                            
      ] }).addStyleClass("sapUiSmallMargin");                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
      var oDlg = new Dialog({                                                                                                                                                                                                                                  
        title: "Exception Control Tower 사용 가이드",                                                                                                                                                                                                               
        contentWidth: "46rem",                                                                                                                                                                                                                                 
        contentHeight: "34rem",                                                                                                                                                                                                                                
        content: [new ScrollContainer({ height: "100%", vertical: true, content: [oBox] })],                                                                                                                                                                   
        endButton: new Button({ text: "닫기", press: function () { oDlg.close(); } }),                                                                                                                                                                           
        afterClose: function () { oDlg.destroy(); }                                                                                                                                                                                                            
      });                                                                                                                                                                                                                                                      
      oDlg.open();                                                                                                                                                                                                                                             
    }                                                                                                                                                                                                                                                          
  };                                                                                                                                                                                                                                                           
});                                                                                                                                                                                                                                                            