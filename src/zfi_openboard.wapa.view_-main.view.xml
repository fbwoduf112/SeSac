<mvc:View controllerName="zfi.openboard.controller.Main"                                                                                                                                                                                                       
    xmlns:mvc="sap.ui.core.mvc"                                                                                                                                                                                                                                
    xmlns:core="sap.ui.core"                                                                                                                                                                                                                                   
    xmlns="sap.m">                                                                                                                                                                                                                                             
    <Page id="page" title="채권·채무 대시보드" class="sapUiNoContentPadding zDash" enableScrolling="false">                                                                                                                                                            
        <customHeader>                                                                                                                                                                                                                                         
            <OverflowToolbar id="hdrBar" height="3.5rem">                                                                                                                                                                                                      
                <Avatar id="logo" displayShape="Square" displaySize="Custom"                                                                                                                                                                                   
                    customDisplaySize="3rem" imageFitType="Contain"                                                                                                                                                                                            
                    backgroundColor="Transparent"/>                                                                                                                                                                                                            
                <Title id="hdrBrand" text="떡잎반도체" class="zBrand"/>                                                                                                                                                                                             
                <ToolbarSeparator id="hdrSep"/>                                                                                                                                                                                                                
                <Title id="hdrTitle" text="채권·채무 현황" class="zScr"/>                                                                                                                                                                                            
            </OverflowToolbar>                                                                                                                                                                                                                                 
        </customHeader>                                                                                                                                                                                                                                        
        <subHeader>                                                                                                                                                                                                                                            
            <OverflowToolbar id="filterBar">                                                                                                                                                                                                                   
                <Label id="lblKeyDate" text="기준일" labelFor="dpKeyDate"/>                                                                                                                                                                                       
                <DatePicker id="dpKeyDate" width="10rem" displayFormat="yyyy.MM.dd"                                                                                                                                                                            
                    dateValue="{dash>/keyDate}" minDate="{dash>/today}" change=".onKeyDate"/>                                                                                                                                                                  
                <ToolbarSpacer id="tbSpacer1"/>                                                                                                                                                                                                                
                <Button id="btnRefresh" text="새로고침" type="Emphasized" icon="sap-icon://refresh" press=".onRefresh"                                                                                                                                             
                    tooltip="지금 조건(기준일·카드·검색어) 그대로 최신 데이터 다시 읽기"/>                                                                                                                                                                                             
                <Button id="btnReset" text="초기화" icon="sap-icon://reset" press=".onReset"                                                                                                                                                                      
                    tooltip="기준일 오늘 + 거르기·검색 해제 + 다시 읽기"/>                                                                                                                                                                                                     
            </OverflowToolbar>                                                                                                                                                                                                                                 
        </subHeader>                                                                                                                                                                                                                                           
        <content>                                                                                                                                                                                                                                              
            <!-- 위 고정 : 제목 + 카드 5개 (스크롤 안 됨) -->                                                                                                                                                                                                               
            <core:HTML id="cardHtml" content="{dash>/cardHtml}" sanitizeContent="false" preferDOM="false"                                                                                                                                                      
                afterRendering=".onHtmlRendered"/>                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            <!-- 아래 스크롤 : 차트 → 목록 (목록 제목줄·검색칸·열 제목은 스크롤해도 위에 붙어 있음) -->                                                                                                                                                                                        
            <ScrollContainer id="dashScroll" vertical="true" horizontal="false" height="100%" class="zDashScroll">                                                                                                                                             
            <core:HTML id="dashHtml" content="{dash>/html}" sanitizeContent="false" preferDOM="false"/>                                                                                                                                                        
                                                                                                                                                                                                                                                               
            <!-- 채권·채무 목록 : 좌우 여백은 표가 아니라 바깥 상자에 (표 width 100% + 여백 = 오른쪽 잘림 방지) -->                                                                                                                                                                           
            <VBox id="listBox" class="sapUiSmallMarginBeginEnd">                                                                                                                                                                                               
              <Table id="list" items="{dash>/rows}" fixedLayout="false"                                                                                                                                                                                        
                  sticky="HeaderToolbar,ColumnHeaders" noDataText="미결 채권·채무가 없어요"                                                                                                                                                                              
                  class="sapUiSmallMarginBottom">                                                                                                                                                                                                              
                  <headerToolbar>                                                                                                                                                                                                                              
                      <OverflowToolbar id="listToolbar">                                                                                                                                                                                                       
                          <Title id="listTitle" text="{dash>/listTitle}" level="H2"/>                                                                                                                                                                          
                          <ToolbarSpacer id="tbSpacer2"/>                                                                                                                                                                                                      
                          <SearchField id="listSearch" width="16rem" placeholder="문서번호 · 거래처명 검색" liveChange=".onListSearch"/>                                                                                                                                 
                      </OverflowToolbar>                                                                                                                                                                                                                       
                  </headerToolbar>                                                                                                                                                                                                                             
                  <columns>                                                                                                                                                                                                                                    
                      <!-- 순서 : 기한 → 구분 → 문서번호 → 거래처명 → 잔액 → 금액 → 송장·청구번호 (SAP 등록 화면과 같은 맥락) -->                                                                                                                                                               
                      <Column id="colDue" width="16rem"><Text id="hdDue" text="기한 상황"/></Column>                                                                                                                                                               
                      <Column id="colType" width="5rem"><Text id="hdType" text="구분"/></Column>                                                                                                                                                                 
                      <Column id="colDoc"><Text id="hdDoc" text="채무·채권번호"/></Column>                                                                                                                                                                           
                      <Column id="colName"><Text id="hdName" text="거래처명"/></Column>                                                                                                                                                                            
                      <Column id="colBal" hAlign="End"><Text id="hdBal" text="잔액 (KRW)"/></Column>                                                                                                                                                             
                      <Column id="colAmt" hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text id="hdAmt" text="금액 (KRW)"/></Column>                                                                                                                 
                      <Column id="colRef" minScreenWidth="XLarge" demandPopin="true"><Text id="hdRef" text="송장·청구번호"/></Column>                                                                                                                                
                  </columns>                                                                                                                                                                                                                                   
                  <items>                                                                                                                                                                                                                                      
                      <ColumnListItem id="rowItem" type="Active" press=".onRowPress">                                                                                                                                                                          
                          <cells>                                                                                                                                                                                                                              
                              <VBox id="cDueBox">                                                                                                                                                                                                              
                                  <ObjectStatus id="cDueMain" text="{dash>dueMain}" state="{dash>bucketState}" icon="{dash>dueIcon}"/>                                                                                                                         
                                  <Text id="cDueSub" text="{dash>dueSub}" class="sapUiTinyMarginTop"/>                                                                                                                                                         
                              </VBox>                                                                                                                                                                                                                          
                              <ObjectStatus id="cType" text="{dash>typeText}" state="{dash>typeState}"/>                                                                                                                                                       
                              <Link id="cDoc" text="{dash>docno}" press=".onRowPress"/>                                                                                                                                                                        
                              <Text id="cName" text="{dash>name1}"/>                                                                                                                                                                                           
                              <ObjectNumber id="cBal" number="{dash>balText}" state="Information" emphasized="true"/>                                                                                                                                          
                              <ObjectNumber id="cAmt" number="{dash>amountText}"/>                                                                                                                                                                             
                              <Text id="cRef" text="{dash>refno}"/>                                                                                                                                                                                            
                          </cells>                                                                                                                                                                                                                             
                      </ColumnListItem>                                                                                                                                                                                                                        
                  </items>                                                                                                                                                                                                                                     
              </Table>                                                                                                                                                                                                                                         
            </VBox>                                                                                                                                                                                                                                            
            </ScrollContainer>                                                                                                                                                                                                                                 
        </content>                                                                                                                                                                                                                                             
    </Page>                                                                                                                                                                                                                                                    
</mvc:View>                                                                                                                                                                                                                                                    